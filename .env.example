# 复制本文件为 .env 后填写真实值，.env 不会被提交到仓库

# ========== 大模型供应商 ==========
# 可选：deepseek / dashscope / zhipu / openai / custom
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-在这里填你的Key
LLM_TEMPERATURE=0.2

# 仅当 LLM_PROVIDER=custom 时需要填写
LLM_BASE_URL=

# ========== 向量化 ==========
# 可选：local（本地 BGE，默认，文档不出本机）/ cloud（云端 API）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ========== 检索参数 ==========
RETRIEVE_TOP_K=5
# 相似度阈值，只作用于向量路（低于该分数的切片丢弃）
# CR-02：由 0.35 上调至 0.6，M1 实测 0.35 对库外问题完全不起过滤作用
RETRIEVE_SCORE_THRESHOLD=0.6
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# ========== 对话 ==========
# 多轮对话保留的历史轮数
HISTORY_ROUNDS=5

# ========== 服务 ==========
# 绑定 0.0.0.0 后，手机 / 其他电脑可通过 内网IP:PORT 访问
HOST=0.0.0.0
PORT=8501

# ========== 上传限制 ==========
MAX_UPLOAD_MB=20
PAGE_SIZE=10

# ========== OCR（二期：图片 / 扫描件入库）==========
# 关闭后图片后缀会被拒绝、扫描件 PDF 只保留告警不入内容
OCR_ENABLED=true

# ========== Agent 工具调度（二期 2.2）==========
# 关闭后问答一律走知识库检索（一键回退）
AGENT_ENABLED=true

# ========== 课件总结 / 复习提纲（二期 2.4）==========
# map-reduce 每批处理的切片数（越大调用次数越少，单次上下文越长）
SUMMARIZE_BATCH_CHUNKS=8

# ========== 路径（留空则使用默认值）==========
# DATA_DIR=
# CHROMA_DIR=
# UPLOAD_DIR=
# DB_PATH=

# ========== 管理员账号（seed_users.py 初始化时使用）==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
